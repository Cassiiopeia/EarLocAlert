# Fastfile for Play Store Deployment
# Path: android/fastlane/Fastfile.playstore
# Based on the projectops Flutter Play Store template
# (.github/util/flutter/playstore-wizard/templates/Fastfile.playstore.template).
#
# CI 워크플로우가 이 파일을 Fastfile 로 복사해 `fastlane deploy_internal` 을 부른다.
# 이 앱의 패키지명(kr.suhsaechan.ear_loc_alert)을 박아 둔 것 외에는 템플릿 구조를 따른다.

# 승급 실패를 **눈에 띄게** 알린다.
#
# GitHub Actions 에서는 애노테이션으로 올려 실행 목록에 뜨게 한다. 로그 안에만 두면
# 초록불에 묻혀 아무도 읽지 않는다. 승급은 DEPLOY_MODE 로 켠 것이므로, 켠 사람은 그
# 승급을 원한 것이다. 안 됐으면 안다.
def report_promote_failure(track, error)
  head = "#{track} 트랙 승급 실패 — 내부 테스트 업로드는 정상 완료되었습니다."
  why  = "사유: #{error.message}"
  what = "확인할 것: (1) 프로덕션에 출시한 적이 한 번도 없다면 Play Console 에서 최초 1회를 " \
         "수동으로 해야 한다 (신규 앱은 API 로 프로덕션 승급이 불가) " \
         "(2) 서비스 계정에 해당 트랙 권한이 있는지 (3) 같은 버전 코드가 이미 그 트랙에 있는지"
  puts "::error title=#{track} 트랙 승급 실패::#{head} / #{why} / #{what}" if ENV["GITHUB_ACTIONS"] == "true"
  puts ""
  puts "❌ #{head}"
  puts "   #{why}"
  puts "   #{what}"
end

default_platform(:android)

platform :android do
  # ============================================================
  # 배포 모드(DEPLOY_MODE) — 워크플로우가 넘긴다 (이슈 #201)
  #
  #   store_only    : 내부 테스트(internal) 업로드까지만
  #   store_prepare : internal 업로드 + production 에 draft 로 올림
  #                   → Play Console 에서 사람이 "출시 시작" 을 눌러야 심사 진행
  #   store_submit  : internal 업로드 + production completed 승급
  #                   → Google 심사 자동 등록 (완전 자동) ← 이 앱의 기본값
  #
  # ⚠️ 프로덕션에 한 번도 출시한 적 없는 앱은 API 로 프로덕션 승급이 안 된다.
  #    최초 1회는 Play Console 에서 수동으로 출시해야 하고, 그 뒤부터 이 lane 이 동작한다.
  #
  # ⚠️ 자동 게시는 되돌릴 수 없다. 잘못된 빌드는 새 버전으로 덮거나
  #    콘솔에서 출시를 중단하는 수밖에 없다. (rollout 은 100% — 아래 promote_internal_to)
  #
  # 직접 이 lane 을 부를 때를 위한 기본값은 **가장 안전한 store_only** 다.
  # 이 앱의 실제 기본값(store_submit)은 워크플로우의 DEPLOY_MODE 에서 정한다.
  # ============================================================
  desc "Deploy to Play Store (DEPLOY_MODE: store_only | store_prepare | store_submit)"
  lane :deploy_internal do
    version_name = ENV["VERSION_NAME"] || "1.0.0"
    version_code = ENV["VERSION_CODE"] || "1"
    aab_path = ENV["AAB_PATH"] || "../build/app/outputs/bundle/release/app-release.aab"
    json_key = ENV["GOOGLE_PLAY_JSON_KEY"] || "~/.config/gcloud/service-account.json"

    deploy_mode = (ENV["DEPLOY_MODE"] || "store_only").strip
    promote = ["store_prepare", "store_submit"].include?(deploy_mode)
    submit = deploy_mode == "store_submit"

    unless ["store_only", "store_prepare", "store_submit"].include?(deploy_mode)
      UI.user_error!("알 수 없는 DEPLOY_MODE: #{deploy_mode} (store_only | store_prepare | store_submit)")
    end
    UI.user_error!("AAB file not found: #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Service Account JSON not found: #{json_key}") unless File.exist?(File.expand_path(json_key))

    puts "========================================="
    puts "📦 #{version_name} (#{version_code}) / 모드: #{deploy_mode} (프로덕션 승급: #{promote} / 심사 자동등록: #{submit})"
    puts "AAB Path: #{aab_path}"
    puts "========================================="

    # ── Step 1: 내부 테스트 트랙에 업로드 ──────────────────────
    # 내부 테스트는 구글 검토가 없어 수 분 안에 끝난다. 프로덕션 승급의 출발점이다.
    upload_to_play_store(
      package_name: "kr.suhsaechan.ear_loc_alert",
      track: "internal",
      aab: aab_path,
      json_key: json_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,  # metadata 디렉토리의 changelog 를 올린다
      release_status: "completed",
      version_name: version_name,
      version_code: version_code
    )
    puts "✅ 내부 테스트 업로드 완료!"

    unless promote
      puts "⏭️  #{deploy_mode} 모드 — 프로덕션 승급 건너뜀"
      next
    end

    # ── Step 2: 내부 테스트 → 프로덕션 승급 ──────────────────────
    #   store_submit  : completed → Google 심사 자동 등록
    #   store_prepare : draft     → 콘솔에서 사람이 "출시 시작"
    promote_status = submit ? "completed" : "draft"
    puts ""
    puts "🚀 프로덕션 트랙으로 승급 중... (release_status: #{promote_status})"
    begin
      promote_internal_to(to: "production", status: promote_status)
    rescue StandardError => e
      # 조용히 넘기지 않는다 — 내부 테스트 업로드는 이미 성공했으므로 그 사실도 함께 알린다.
      report_promote_failure("프로덕션(production)", e)
      raise
    end

    puts ""
    if submit
      puts "✅ 프로덕션: Google 심사 자동 등록됨 (통과 후 전체 출시)"
    else
      puts "✅ 프로덕션 draft 준비 완료 — Play Console 에서 '출시 시작' 을 누르면 심사가 진행됩니다."
    end
  end

  # 내부 테스트 트랙에서 다른 트랙으로 승급하는 공통 동작.
  # 트랙을 늘릴 때(예: 공개 테스트 beta) 이 lane 에 to: 만 바꿔 부르면 된다.
  private_lane :promote_internal_to do |options|
    upload_to_play_store(
      package_name: "kr.suhsaechan.ear_loc_alert",
      track: "internal",
      track_promote_to: options[:to],
      track_promote_release_status: options[:status] || "completed",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || "~/.config/gcloud/service-account.json",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,  # 이미 업로드됨
      rollout: "1.0",                # 100% 전면 출시 (심사 통과 후 자동 적용)
      changes_not_sent_for_review: false,
      # 거짓 성공 차단: 심사 자동제출 실패를 성공으로 바꾸지 않는다
      rescue_changes_not_sent_for_review: false
    )
  end

  desc "Validate Service Account JSON"
  lane :validate do
    json_key = ENV["GOOGLE_PLAY_JSON_KEY"] || "~/.config/gcloud/service-account.json"
    validate_play_store_json_key(json_key: json_key)
    puts "Service Account validation successful!"
  end
end
