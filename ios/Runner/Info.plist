<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- ==========================================================
	     위치 권한 사유 (docs/09-RELEASE.md)

	     이 문구는 심사자가 읽고, 사용자도 권한 다이얼로그에서 읽는다.
	     두 목적을 동시에 만족해야 한다.
	     "위치 정보가 필요합니다" 같은 문구는 반려된다.
	     ========================================================== -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Shows your current position on the map when you add a place to be alerted about. For example, when you save the bus stop near your home, the map opens where you are so you can tap the stop right away. Your location stays on this device and is never sent elsewhere.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Checks your location in the background so the app can alert you when you arrive at or leave a saved place, even while it is closed. For example, if you save the stop where you get off on the way home, your phone vibrates or your earphones play a sound when you reach it, even while you are watching a video. Your location stays on this device and is never sent elsewhere.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>Checks your location in the background so the app can alert you when you arrive at or leave a saved place, even while it is closed. For example, if you save the stop where you get off on the way home, your phone vibrates or your earphones play a sound when you reach it, even while you are watching a video. Your location stays on this device and is never sent elsewhere.</string>
		<!-- 백그라운드 위치 — Apple 은 "정말 필요한가"를 심사한다.
	     이 앱은 앱을 보고 있지 않을 때 알리는 것이 목적이므로
	     백그라운드 없이는 기능이 성립하지 않는다 (docs/09-RELEASE.md). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>audio</string>
		</array>
		<!-- 아래 두 키는 앱이 직접 쓰지 않는다. 포함된 라이브러리(file_picker, audio_session)가
	     해당 API 를 참조해 App Store Connect 가 문구를 요구한다 (ITMS-90683, 이슈 #194) -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Only used when you pick your own sound file for an alert. The app does not read your photos.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>The app never records audio. Microphone access is not used.</string>
		<!-- NSUserTrackingUsageDescription 은 일부러 두지 않는다 (이슈 #196). 이 앱은 ATT 를 요청하지
	     않고 추적하지 않는다. 키가 있으면 App Store Connect 가 "추적 선언"을 요구해 심사 제출이 막힌다.
	     ATT 를 도입하면 App Privacy 의 추적 응답과 함께 되살린다 (docs/10-DECISIONS.md). -->
		<!-- AdMob 앱 ID — 공개 정보다. 실제 발급 후 교체한다.
	     현재는 Google 공개 테스트 ID (docs/07-MONETIZATION.md). -->
		<key>GADApplicationIdentifier</key>
		<string>ca-app-pub-2025665624324395~6848618910</string>
		<key>CFBundleDisplayName</key>
		<string>EarLocAlert</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>ear_loc_alert</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Google Maps API 키 (docs/08-OPERATIONS.md).
		     값은 MapsKey.xcconfig 에서 온다 — tool/sync_env.sh 가 .env 로
		     만들며 커밋되지 않는다. AppDelegate 가 이 값을 읽어 SDK 를 켠다.
		     비어 있으면 지도만 회색으로 뜨고 앱은 정상 동작한다. -->
		<key>MapsApiKey</key>
		<string>$(MAPS_API_KEY)</string>
	</dict>
</plist>
